{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/postgres-collection-manifest-v1.schema.json",
  "title": "postgres-collection-manifest-v1",
  "type": "object",
  "required": [
    "postgres_collection_manifest_version",
    "kind",
    "complete",
    "files",
    "table_manifests"
  ],
  "properties": {
    "postgres_collection_manifest_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "postgresql-table-collection-export"
    },
    "complete": {
      "const": true,
      "type": "boolean"
    },
    "files": {
      "type": "object",
      "required": [
        "receipt.json",
        "summary.json"
      ],
      "properties": {
        "receipt.json": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary.json": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "table_manifests": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z][a-z0-9_-]{0,31}$",
        "not": {
          "pattern": "[^a-z0-9_-]"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false,
  "description": "Structural schema only. Strict JSON token types, canonical bytes, printable text, UTF-8 identifier byte limits, cross-field bindings and filesystem safety require contract 277 runtime validation."
}
