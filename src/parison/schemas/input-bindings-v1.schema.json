{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_version",
    "policy",
    "bindings"
  ],
  "properties": {
    "binding_version": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "suite",
            "reconciliation"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "source_kind",
          "selection",
          "source_sha256",
          "policy_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "source_kind": {
            "enum": [
              "file",
              "partition"
            ]
          },
          "selection": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "file"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "partition"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "table"
                ],
                "properties": {
                  "kind": {
                    "const": "sqlite-table"
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer"
                ],
                "properties": {
                  "kind": {
                    "const": "json-pointer"
                  },
                  "pointer": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "record_path",
                  "namespaces"
                ],
                "properties": {
                  "kind": {
                    "const": "xml-record"
                  },
                  "record_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespaces": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sheet",
                  "range"
                ],
                "properties": {
                  "kind": {
                    "const": "xlsx-range"
                  },
                  "sheet": {
                    "type": "string",
                    "minLength": 1
                  },
                  "range": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "table"
                ],
                "properties": {
                  "kind": {
                    "const": "xlsx-table"
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "const": "xlsx-defined-name"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "policy_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_kind": {
                  "const": "partition"
                }
              }
            },
            "then": {
              "properties": {
                "selection": {
                  "properties": {
                    "kind": {
                      "const": "partition"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "selection": {
                  "properties": {
                    "kind": {
                      "not": {
                        "const": "partition"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/input-bindings-v1.schema.json"
}
