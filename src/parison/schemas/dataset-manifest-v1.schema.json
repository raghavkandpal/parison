{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/dataset-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "collection_id", "policy", "resources"],
  "properties": {
    "manifest_version": {"const": 1},
    "collection_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["kind", "sha256"],
      "properties": {"kind": {"enum": ["suite", "reconciliation"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "resources": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "allOf": [{"if": {"properties": {"format": {"const": "json"}}, "required": ["format"]}, "then": {"properties": {"role": {"enum": ["receipt", "supporting"]}}}}],
        "required": ["id", "role", "format", "path", "bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "role": {"enum": ["baseline", "candidate", "receipt", "supporting"]},
          "format": {"enum": ["csv", "tsv", "json", "jsonl", "parquet", "sqlite"]},
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
