                    "pattern": "[\\u0000\\uD800-\\uDFFF]"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "ctype": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "not": {
                    "pattern": "[\\u0000\\uD800-\\uDFFF]"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "locale": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "not": {
                    "pattern": "[\\u0000\\uD800-\\uDFFF]"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "rules": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096,
                  "not": {
                    "pattern": "[\\u0000\\uD800-\\uDFFF]"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "recorded_version": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "state",
                    "value"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "known"
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 512,
                      "not": {
                        "pattern": "[\\u0000\\uD800-\\uDFFF]"
                      },
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "state",
                    "value"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "not-versioned",
                        "unknown",
                        "not-applicable"
                      ]
                    },
                    "value": {
                      "type": "null"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "actual_version": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "state",
                    "value"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "known"
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 512,
                      "not": {
                        "pattern": "[\\u0000\\uD800-\\uDFFF]"
                      },
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "state",
                    "value"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "not-versioned",
                        "unknown",
                        "not-applicable"
                      ]
                    },
                    "value": {
                      "type": "null"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
