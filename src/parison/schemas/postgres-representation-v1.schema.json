                  "type": "null"
                }
              ]
            },
            "encoding": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "deterministic": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "collate": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512,
