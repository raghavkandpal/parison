              },
              "then": {
                "properties": {
                  "origin": {
                    "type": "string",
                    "const": "none"
                  },
                  "schema": {
                    "type": "null"
                  },
                  "name": {
                    "type": "null"
                  },
                  "provider": {
                    "type": "null"
                  },
                  "encoding": {
                    "type": "null"
                  },
                  "deterministic": {
                    "type": "null"
                  },
                  "collate": {
                    "type": "null"
                  },
                  "ctype": {
                    "type": "null"
                  },
                  "locale": {
                    "type": "null"
                  },
                  "rules": {
                    "type": "null"
                  },
                  "recorded_version": {
                    "type": "object",
                    "required": [
                      "state",
                      "value"
                    ],
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "not-applicable"
                      },
                      "value": {
                        "type": "null"
                      }
                    },
                    "additionalProperties": false
                  },
                  "actual_version": {
                    "type": "object",
                    "required": [
                      "state",
                      "value"
                    ],
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "not-applicable"
                      },
                      "value": {
                        "type": "null"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "unknown"
                  }
                }
              },
              "then": {
                "properties": {
                  "origin": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "schema": {
                    "type": "null"
                  },
                  "name": {
                    "type": "null"
                  },
                  "provider": {
                    "type": "null"
                  },
                  "encoding": {
                    "type": "null"
                  },
                  "deterministic": {
                    "type": "null"
                  },
                  "collate": {
                    "type": "null"
                  },
                  "ctype": {
                    "type": "null"
                  },
                  "locale": {
                    "type": "null"
                  },
                  "rules": {
                    "type": "null"
                  },
                  "recorded_version": {
                    "type": "object",
                    "required": [
                      "state",
                      "value"
                    ],
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "value": {
                        "type": "null"
                      }
                    },
                    "additionalProperties": false
                  },
                  "actual_version": {
                    "type": "object",
                    "required": [
                      "state",
                      "value"
                    ],
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "value": {
                        "type": "null"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "resolved"
                  }
                }
              },
              "then": {
                "properties": {
                  "origin": {
