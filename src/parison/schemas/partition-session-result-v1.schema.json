{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/partition-session-result-v1.schema.json",
  "title": "partition-session-result-v1",
  "description": "Structural validation only; canonical bytes, exact JSON tokens, cross-file bindings and execution assurance require the semantic reader/replay gate.",
  "type": "object",
  "required": [
    "partition_session_result_version",
    "action",
    "state",
    "execution_assurance",
    "reused_routing",
    "reused_partitions",
    "computed_partitions",
    "sensitive_retained",
    "summary"
  ],
  "properties": {
    "partition_session_result_version": {
      "type": "integer",
      "const": 1
    },
    "action": {
      "enum": [
        "discover",
        "resume",
        "preview",
        "abandon"
      ]
    },
    "state": {
      "enum": [
        "initializing",
        "routed",
        "comparing",
        "ready",
        "published",
        "abandoning",
        "abandoned"
      ]
    },
    "execution_assurance": {
      "enum": [
        "fresh-exact",
        "reused-integrity-checked",
        "not-executed"
      ]
    },
    "reused_routing": {
      "type": "boolean"
    },
    "reused_partitions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "computed_partitions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "sensitive_retained": {
      "type": "boolean"
    },
    "summary": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/summary"
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "preview",
              "abandon"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution_assurance": {
            "const": "not-executed"
          },
          "reused_routing": {
            "const": false
          },
          "reused_partitions": {
            "const": 0
          },
          "computed_partitions": {
            "const": 0
          },
          "summary": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "abandon"
                }
              }
            },
            "then": {
              "properties": {
                "state": {
                  "const": "abandoned"
                },
                "sensitive_retained": {
                  "const": false
                }
              }
            },
            "else": {
              "properties": {
                "state": {
                  "enum": [
                    "initializing",
                    "routed",
                    "comparing",
                    "ready",
                    "published",
                    "abandoning"
                  ]
                },
                "sensitive_retained": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "state": {
            "const": "published"
          },
          "sensitive_retained": {
            "const": true
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "execution_assurance": {
            "enum": [
              "fresh-exact",
              "reused-integrity-checked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_assurance": {
            "const": "fresh-exact"
          }
        }
      },
      "then": {
        "properties": {
          "reused_routing": {
            "const": false
          },
          "reused_partitions": {
            "const": 0
          },
          "computed_partitions": {
            "type": "integer",
            "minimum": 2,
            "maximum": 128
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "discover"
          }
        }
      },
      "then": {
        "properties": {
          "execution_assurance": {
            "const": "fresh-exact"
          }
        }
      }
    }
  ],
  "$defs": {
    "summary": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "partition_receipt_version",
            "policy_sha256",
            "plan_sha256",
            "inputs",
            "route_rows",
            "staged_bytes",
            "counts",
            "discrepancy_count",
            "outcome",
            "complete"
          ],
          "properties": {
            "partition_receipt_version": {
              "const": 1
            },
            "policy_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "inputs": {
              "type": "object",
              "required": [
                "baseline",
                "candidate"
              ],
              "properties": {
                "baseline": {
                  "type": "object",
                  "required": [
                    "sha256",
                    "bytes"
                  ],
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "candidate": {
                  "type": "object",
                  "required": [
                    "sha256",
                    "bytes"
                  ],
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "route_rows": {
              "type": "object",
              "required": [
                "baseline",
                "candidate"
              ],
              "properties": {
                "baseline": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidate": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "staged_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "counts": {
              "type": "object",
              "required": [
                "baseline",
                "candidate",
                "common_keys",
                "baseline_only",
                "candidate_only",
                "matched_exact",
                "matched_within_tolerance",
                "matched_with_required_difference"
              ],
              "properties": {
                "baseline": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidate": {
                  "type": "integer",
                  "minimum": 0
                },
                "common_keys": {
                  "type": "integer",
                  "minimum": 0
                },
                "baseline_only": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidate_only": {
                  "type": "integer",
                  "minimum": 0
                },
                "matched_exact": {
                  "type": "integer",
                  "minimum": 0
                },
                "matched_within_tolerance": {
                  "type": "integer",
                  "minimum": 0
                },
                "matched_with_required_difference": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "discrepancy_count": {
              "type": "integer",
              "minimum": 0
            },
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE"
              ]
            },
            "complete": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "partition_receipt_version",
            "policy_sha256",
            "plan_sha256",
            "inputs",
            "route_rows",
            "staged_bytes",
            "counts",
            "discrepancy_count",
            "outcome",
            "complete",
            "routing",
            "normalization_runtime"
          ],
          "properties": {
            "partition_receipt_version": {
              "type": "integer",
              "const": 2
            },
            "policy_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "inputs": {
              "type": "object",
              "required": [
                "baseline",
                "candidate"
              ],
              "properties": {
                "baseline": {
                  "type": "object",
                  "required": [
                    "sha256",
                    "bytes"
                  ],
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    }
                  },
                  "additionalProperties": false
                },
                "candidate": {
                  "type": "object",
                  "required": [
                    "sha256",
                    "bytes"
                  ],
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "route_rows": {
              "type": "object",
              "required": [
                "baseline",
                "candidate"
              ],
              "properties": {
                "baseline": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5000000
                },
                "candidate": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5000000
                }
              },
              "additionalProperties": false
            },
            "staged_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000000
            },
            "counts": {
              "type": "object",
              "required": [
                "baseline",
                "candidate",
                "common_keys",
                "baseline_only",
                "candidate_only",
                "matched_exact",
                "matched_within_tolerance",
                "matched_with_required_difference"
              ],
              "properties": {
                "baseline": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidate": {
                  "type": "integer",
                  "minimum": 0
                },
                "common_keys": {
                  "type": "integer",
                  "minimum": 0
                },
                "baseline_only": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidate_only": {
                  "type": "integer",
                  "minimum": 0
                },
                "matched_exact": {
                  "type": "integer",
                  "minimum": 0
                },
                "matched_within_tolerance": {
                  "type": "integer",
                  "minimum": 0
                },
                "matched_with_required_difference": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "discrepancy_count": {
              "type": "integer",
              "minimum": 0
            },
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "routing": {
              "type": "object",
              "required": [
                "kind",
                "hash",
                "encoding",
                "buckets"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "hash-v1"
                },
                "hash": {
                  "type": "string",
                  "const": "sha256"
                },
                "encoding": {
                  "type": "string",
                  "const": "typed-key-v1"
                },
                "buckets": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 128
                }
              },
              "additionalProperties": false
            },
            "normalization_runtime": {
              "type": "object",
              "required": [
                "implementation",
                "python_version",
                "unicode_version"
              ],
              "properties": {
                "implementation": {
                  "type": "string",
                  "const": "CPython"
                },
                "python_version": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 9,
                  "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,3}$",
                  "not": {
                    "pattern": "[^0-9.]"
                  }
                },
                "unicode_version": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 8,
                  "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,2}$",
                  "not": {
                    "pattern": "[^0-9.]"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
