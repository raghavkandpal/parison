{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/postgres-rehearsal-plan-v1.schema.json",
  "title": "postgres-rehearsal-plan-v1",
  "type": "object",
  "required": [
    "rehearsal_plan_version",
    "pairs",
    "coordination",
    "policies",
    "partitions",
    "reconciliation_sha256",
    "limits"
  ],
  "properties": {
    "rehearsal_plan_version": {
      "type": "integer",
      "const": 1
    },
    "pairs": {
      "type": "object",
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "required": [
            "manifest_sha256",
            "pair_plan_sha256",
            "snapshot",
            "expected_rows",
            "types"
          ],
          "properties": {
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pair_plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "snapshot": {
              "type": "string",
              "minLength": 1
            },
            "expected_rows": {
              "type": "object",
              "required": [
                "orders",
                "order_lines"
              ],
              "properties": {
                "orders": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 300000
                },
                "order_lines": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 300000
                }
              },
              "additionalProperties": false
            },
            "types": {
              "type": "object",
              "required": [
                "orders",
                "order_lines"
              ],
              "properties": {
                "orders": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "int2",
                      "int4",
                      "int8",
                      "numeric",
                      "bool",
                      "text",
                      "varchar",
                      "uuid",
                      "date",
                      "timestamp",
                      "timestamptz"
                    ]
                  }
                },
                "order_lines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "int2",
                      "int4",
                      "int8",
                      "numeric",
                      "bool",
                      "text",
                      "varchar",
                      "uuid",
                      "date",
                      "timestamp",
                      "timestamptz"
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": [
            "manifest_sha256",
            "pair_plan_sha256",
            "snapshot",
            "expected_rows",
            "types"
          ],
          "properties": {
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pair_plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "snapshot": {
              "type": "string",
              "minLength": 1
            },
            "expected_rows": {
              "type": "object",
              "required": [
                "orders",
                "order_lines"
              ],
              "properties": {
                "orders": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 300000
                },
                "order_lines": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 300000
                }
              },
              "additionalProperties": false
            },
            "types": {
              "type": "object",
              "required": [
                "orders",
                "order_lines"
              ],
              "properties": {
                "orders": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "int2",
                      "int4",
                      "int8",
                      "numeric",
                      "bool",
                      "text",
                      "varchar",
                      "uuid",
                      "date",
                      "timestamp",
                      "timestamptz"
                    ]
                  }
                },
                "order_lines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "int2",
                      "int4",
                      "int8",
                      "numeric",
                      "bool",
                      "text",
                      "varchar",
                      "uuid",
                      "date",
                      "timestamp",
                      "timestamptz"
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coordination": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "claim_sha256"
          ],
          "properties": {
            "mode": {
              "const": "source-owned"
            },
            "claim_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "claim_sha256"
          ],
          "properties": {
            "mode": {
              "const": "unestablished"
            },
            "claim_sha256": {
              "type": "null"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "policies": {
      "type": "object",
      "required": [
        "orders",
        "order_lines"
      ],
      "properties": {
        "orders": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "order_lines": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "partitions": {
      "type": "object",
      "required": [
        "orders",
        "order_lines"
      ],
      "properties": {
        "orders": {
          "type": "object",
          "required": [
            "partition_plan_version",
            "ranges",
            "limits"
          ],
          "properties": {
            "partition_plan_version": {
              "const": 1
            },
            "ranges": {
              "type": "array",
              "minItems": 2,
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": [
                  "upper"
                ],
                "properties": {
                  "upper": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "max_input_bytes",
                "max_rows_per_input",
                "max_rows_per_partition_side",
                "max_staged_bytes",
                "max_partition_bytes"
              ],
              "properties": {
                "max_input_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "max_rows_per_input": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000000
                },
                "max_rows_per_partition_side": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "max_staged_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000000000
                },
                "max_partition_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "order_lines": {
          "type": "object",
          "required": [
            "partition_plan_version",
            "ranges",
            "limits"
          ],
          "properties": {
            "partition_plan_version": {
              "const": 1
            },
            "ranges": {
              "type": "array",
              "minItems": 2,
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": [
                  "upper"
                ],
                "properties": {
                  "upper": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "max_input_bytes",
                "max_rows_per_input",
                "max_rows_per_partition_side",
                "max_staged_bytes",
                "max_partition_bytes"
              ],
              "properties": {
                "max_input_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "max_rows_per_input": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000000
                },
                "max_rows_per_partition_side": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "max_staged_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000000000
                },
                "max_partition_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reconciliation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limits": {
      "type": "object",
      "required": [
        "max_input_bytes",
        "max_rows",
        "max_keys",
        "max_groups",
        "max_temp_bytes"
      ],
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_keys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_groups": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_temp_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
