{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/partition-summary-v1.schema.json",
  "title": "partition-summary-v1",
  "type": "object",
  "required": [
    "partition_receipt_version",
    "policy_sha256",
    "plan_sha256",
    "inputs",
    "route_rows",
    "staged_bytes",
    "counts",
    "discrepancy_count",
    "outcome",
    "complete"
  ],
  "properties": {
    "partition_receipt_version": {
      "const": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "route_rows": {
      "type": "object",
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "integer",
          "minimum": 0
        },
        "candidate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "staged_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "required": [
        "baseline",
        "candidate",
        "common_keys",
        "baseline_only",
        "candidate_only",
        "matched_exact",
        "matched_within_tolerance",
        "matched_with_required_difference"
      ],
      "properties": {
        "baseline": {
          "type": "integer",
          "minimum": 0
        },
        "candidate": {
          "type": "integer",
          "minimum": 0
        },
        "common_keys": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_only": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_only": {
          "type": "integer",
          "minimum": 0
        },
        "matched_exact": {
          "type": "integer",
          "minimum": 0
        },
        "matched_within_tolerance": {
          "type": "integer",
          "minimum": 0
        },
        "matched_with_required_difference": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "discrepancy_count": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "complete": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
