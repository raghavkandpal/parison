{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raghavkandpal/parison/schemas/suite-result-v1.schema.json",
  "title": "Parison suite result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_version", "outcome", "complete", "runtime", "total_cases", "completed_cases", "outcome_counts", "cases", "suite_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_version": {"const": 1},
    "outcome": {"enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "INTERRUPTED"]},
    "complete": {"type": "boolean"},
    "runtime": {"type": "object"},
    "total_cases": {"type": "integer", "minimum": 1, "maximum": 100},
    "completed_cases": {"type": "integer", "minimum": 1, "maximum": 100},
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "INTERRUPTED"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "ERROR": {"type": "integer", "minimum": 0},
        "INCONCLUSIVE": {"type": "integer", "minimum": 0},
        "INTERRUPTED": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "complete", "schema_version", "contract", "policy_sha256", "manifest_sha256", "bundle"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "outcome": {"enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "INTERRUPTED"]},
          "complete": {"type": "boolean"},
          "schema_version": {"type": "integer", "minimum": 1, "maximum": 3},
          "contract": {"enum": ["keyed-v1", "aggregate-v1", "multiset-v1"]},
          "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bundle": {"type": "string", "pattern": "^cases/[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
