{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/postgres-pair-receipt-v1.schema.json",
  "title": "postgres-pair-receipt-v1",
  "type": "object",
  "required": [
    "postgres_pair_receipt_version",
    "kind",
    "pair_plan_sha256",
    "source",
    "transaction",
    "table_manifests",
    "limits",
    "observed"
  ],
  "properties": {
    "postgres_pair_receipt_version": {
      "const": 1
    },
    "kind": {
      "const": "postgresql-two-table-export"
    },
    "pair_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "database",
        "role",
        "server_version_num"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "server_version_num": {
          "type": "integer",
          "minimum": 160000,
          "maximum": 999999
        }
      },
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "required": [
        "isolation",
        "read_only",
        "row_security",
        "snapshot"
      ],
      "properties": {
        "isolation": {
          "const": "repeatable read"
        },
        "read_only": {
          "const": true
        },
        "row_security": {
          "const": "off"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "table_manifests": {
      "type": "object",
      "required": [
        "orders",
        "order_lines"
      ],
      "properties": {
        "orders": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "order_lines": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_rows",
        "max_output_bytes",
        "statement_timeout_ms",
        "wall_timeout_ms"
      ],
      "properties": {
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "statement_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "wall_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": [
        "rows",
        "bytes",
        "elapsed_ms",
        "complete"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "complete": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
