{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raghavkandpal/parison/schemas/suite-v1.schema.json",
  "title": "Parison comparison suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "cases"],
  "properties": {
    "suite_version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recipe", "baseline", "candidate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "recipe": {"type": "string", "minLength": 1},
          "baseline": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1},
          "expected_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
