{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/conservation-result-v1.schema.json",
  "title": "Parison conservation result v1",
  "type": "object",
  "required": ["conservation_result_version", "outcome", "reconciliation_sha256", "engine", "sides", "resource_limits"],
  "properties": {
    "conservation_result_version": {"const": 1},
    "outcome": {"enum": ["PASS", "FAIL"]},
    "reconciliation_sha256": {"$ref": "#/$defs/digest"},
    "engine": {"enum": ["memory", "sqlite"]},
    "sides": {"type": "object", "required": ["baseline", "candidate"], "properties": {"baseline": {"$ref": "#/$defs/checks"}, "candidate": {"$ref": "#/$defs/checks"}}, "additionalProperties": false},
    "resource_limits": {"type": "object", "required": ["max_input_bytes", "max_decoded_bytes", "max_rows_per_input", "max_groups_per_check"], "properties": {"max_input_bytes": {"type": "integer", "minimum": 1}, "max_decoded_bytes": {"type": "integer", "minimum": 1}, "max_rows_per_input": {"type": "integer", "minimum": 1}, "max_groups_per_check": {"type": "integer", "minimum": 1}, "max_temp_bytes": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "temporary_bytes": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "outcome", "counts"], "properties": {"id": {"type": "string"}, "kind": {"const": "conservation"}, "outcome": {"enum": ["PASS", "FAIL"]}, "counts": {"$ref": "#/$defs/counts"}}, "additionalProperties": false}},
    "counts": {"type": "object", "required": ["parent_rows", "child_rows", "groups", "compared_groups", "exact_groups", "within_tolerance_groups", "different_groups", "child_only_groups", "parent_without_children_groups", "duplicate_parent_groups", "null_measure_rows"], "properties": {"parent_rows": {"type": "integer", "minimum": 0}, "child_rows": {"type": "integer", "minimum": 0}, "groups": {"type": "integer", "minimum": 0}, "compared_groups": {"type": "integer", "minimum": 0}, "exact_groups": {"type": "integer", "minimum": 0}, "within_tolerance_groups": {"type": "integer", "minimum": 0}, "different_groups": {"type": "integer", "minimum": 0}, "child_only_groups": {"type": "integer", "minimum": 0}, "parent_without_children_groups": {"type": "integer", "minimum": 0}, "duplicate_parent_groups": {"type": "integer", "minimum": 0}, "null_measure_rows": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  }
}
