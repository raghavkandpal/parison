{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/representation-assessment-plan-v1.schema.json",
  "title": "representation-assessment-plan-v1",
  "description": "Structural schema. Strict token types, UTF-8 byte caps, canonical bytes, normalization and cross-record bindings require contract284 runtime validation.",
  "type": "object",
  "required": [
    "assessment_plan_version",
    "baseline_manifest_sha256",
    "candidate_manifest_sha256",
    "tables",
    "rules"
  ],
  "properties": {
    "assessment_plan_version": {
      "type": "integer",
      "const": 1
    },
    "baseline_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z][a-z0-9_-]{0,31}$",
        "not": {
          "pattern": "[^a-z0-9_-]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "baseline_id",
          "candidate_id",
          "evolution"
        ],
        "properties": {
          "baseline_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                "not": {
                  "pattern": "[^a-z0-9_-]"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                "not": {
                  "pattern": "[^a-z0-9_-]"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "evolution": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "evolution_version",
                  "direction",
                  "changes"
                ],
                "properties": {
                  "evolution_version": {
                    "type": "integer",
                    "const": 1
                  },
                  "direction": {
                    "const": "baseline-to-candidate"
                  },
                  "changes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/evolution_change"
                    },
                    "maxItems": 200
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "not": {
              "properties": {
                "baseline_id": {
                  "type": "null"
                },
                "candidate_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "baseline_id": {
                  "type": "string"
                },
                "candidate_id": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "evolution": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "evolution": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "integer",
        "numeric",
        "text_length",
        "datetime_precision",
        "nullability"
      ],
      "properties": {
        "integer": {
          "type": "string",
          "enum": [
            "exact",
            "widen"
          ]
        },
        "numeric": {
          "type": "string",
          "enum": [
            "exact",
            "widen"
          ]
        },
        "text_length": {
          "type": "string",
          "enum": [
            "exact",
            "widen"
          ]
        },
        "datetime_precision": {
          "type": "string",
          "enum": [
            "exact",
            "widen"
          ]
        },
        "nullability": {
          "type": "string",
          "enum": [
            "exact",
            "relax"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evolution_field": {
      "type": "object",
      "required": [
        "id",
        "name",
        "presence",
        "nullability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "not": {
            "pattern": "[^a-z0-9_-]"
          }
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          },
          "minLength": 1
        },
        "presence": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "nullability": {
          "enum": [
            "non-null",
            "nullable"
          ]
        },
        "default": {
          "type": [
            "null",
            "boolean",
            "integer",
            "number",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "evolution_change": {
      "type": "object",
      "required": [
        "change",
        "baseline",
        "candidate"
      ],
      "properties": {
        "change": {
          "enum": [
            "unchanged",
            "renamed",
            "added",
            "removed",
            "split",
            "merged"
          ]
        },
        "baseline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evolution_field"
          },
          "maxItems": 100
        },
        "candidate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evolution_field"
          },
          "maxItems": 100
        }
      },
      "additionalProperties": false
    }
  }
}
