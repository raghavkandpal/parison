{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/discrepancy-drilldown-v1.schema.json",
  "title": "Parison discrepancy drill-down v1",
  "type": "object",
  "required": ["drilldown_version", "kind", "sensitivity", "group_id", "limit", "per_run_limit", "runs", "returned_size", "items"],
  "properties": {
    "drilldown_version": {"const": 1}, "kind": {"const": "discrepancy-drilldown"}, "sensitivity": {"const": "raw"},
    "group_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "limit": {"type": "integer", "minimum": 1}, "per_run_limit": {"type": "integer", "minimum": 1},
    "runs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["bundle_sha256", "policy_sha256", "population_count", "published_sample_size", "matched_sample_size", "returned_size", "sample_complete"], "properties": {
      "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "population_count": {"type": "integer", "minimum": 0}, "published_sample_size": {"type": "integer", "minimum": 0}, "matched_sample_size": {"type": "integer", "minimum": 0}, "returned_size": {"type": "integer", "minimum": 0}, "sample_complete": {"type": "boolean"}
    }, "additionalProperties": false}},
    "returned_size": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "items": {"type": "object", "required": ["run_index", "sample_index", "item"], "properties": {"run_index": {"type": "integer", "minimum": 0}, "sample_index": {"type": "integer", "minimum": 0}, "item": {"type": "object"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
