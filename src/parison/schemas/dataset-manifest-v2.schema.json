{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "collection_id",
    "policy",
    "closed_scopes",
    "files",
    "bindings"
  ],
  "properties": {
    "manifest_version": {
      "const": 2
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "suite",
            "reconciliation"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "closed_scopes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "source_kind",
          "source",
          "members",
          "source_sha256",
          "policy_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "source_kind": {
            "enum": [
              "file",
              "partition"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "policy_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_kind": {
                  "const": "file"
                }
              }
            },
            "then": {
              "properties": {
                "members": {
                  "maxItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/dataset-manifest-v2.schema.json"
}
