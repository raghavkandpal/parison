{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/investigation-plan-v1.schema.json",
  "title": "investigation-plan-v1",
  "type": "object",
  "required": [
    "investigation_plan_version",
    "discovery_manifest_sha256",
    "partition_indices",
    "limits"
  ],
  "properties": {
    "investigation_plan_version": {
      "const": 1
    },
    "discovery_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_cases_total",
        "max_cases_per_partition",
        "max_staged_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "max_cases_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_cases_per_partition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_staged_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
