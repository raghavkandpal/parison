{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raghavkandpal/parison/main/src/parison/schemas/preflight-v16.schema.json",
  "title": "Parison keyed structured preflight result v16",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "comparison_mode", "keys", "canonical_columns", "policy_sha256", "inputs", "field_projection"],
  "properties": {
    "schema_version": {"const": 16},
    "status": {"enum": ["valid", "invalid"]},
    "comparison_mode": {"const": "keyed"},
    "keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "canonical_columns": {"type": "integer", "minimum": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "field_projection": {"type": "object", "additionalProperties": false, "required": ["version", "baseline", "candidate"], "properties": {"version": {"const": 1}, "baseline": {"$ref": "#/$defs/sideProjection"}, "candidate": {"$ref": "#/$defs/sideProjection"}}},
    "inputs": {"$ref": "#/$defs/inputs"}
  },
  "allOf": [
    {"oneOf": [
      {"properties": {"field_projection": {"properties": {"baseline": {"properties": {"kind": {"const": "json-pointer-v1"}}, "required": ["kind"]}}, "required": ["baseline"]}, "inputs": {"properties": {"baseline": {"properties": {"format": {"const": "json"}}, "required": ["format"]}}, "required": ["baseline"]}}, "required": ["field_projection", "inputs"]},
      {"properties": {"field_projection": {"properties": {"baseline": {"properties": {"kind": {"const": "xml-field-v1"}}, "required": ["kind"]}}, "required": ["baseline"]}, "inputs": {"properties": {"baseline": {"properties": {"format": {"const": "xml"}}, "required": ["format"]}}, "required": ["baseline"]}}, "required": ["field_projection", "inputs"]},
      {"properties": {"field_projection": {"properties": {"baseline": {"properties": {"kind": {"const": "direct-v1"}}, "required": ["kind"]}}, "required": ["baseline"]}, "inputs": {"properties": {"baseline": {"properties": {"format": {"not": {"enum": ["json", "xml"]}}}, "required": ["format"]}}, "required": ["baseline"]}}, "required": ["field_projection", "inputs"]}
    ]},
    {"oneOf": [
      {"properties": {"field_projection": {"properties": {"candidate": {"properties": {"kind": {"const": "json-pointer-v1"}}, "required": ["kind"]}}, "required": ["candidate"]}, "inputs": {"properties": {"candidate": {"properties": {"format": {"const": "json"}}, "required": ["format"]}}, "required": ["candidate"]}}, "required": ["field_projection", "inputs"]},
      {"properties": {"field_projection": {"properties": {"candidate": {"properties": {"kind": {"const": "xml-field-v1"}}, "required": ["kind"]}}, "required": ["candidate"]}, "inputs": {"properties": {"candidate": {"properties": {"format": {"const": "xml"}}, "required": ["format"]}}, "required": ["candidate"]}}, "required": ["field_projection", "inputs"]},
      {"properties": {"field_projection": {"properties": {"candidate": {"properties": {"kind": {"const": "direct-v1"}}, "required": ["kind"]}}, "required": ["candidate"]}, "inputs": {"properties": {"candidate": {"properties": {"format": {"not": {"enum": ["json", "xml"]}}}, "required": ["format"]}}, "required": ["candidate"]}}, "required": ["field_projection", "inputs"]}
    ]}
  ],
  "$defs": {
    "sideProjection": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "fields"], "properties": {"kind": {"enum": ["direct-v1", "json-pointer-v1"]}, "fields": {"$ref": "#/$defs/fieldMap"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "namespaces", "fields"], "properties": {"kind": {"const": "xml-field-v1"}, "namespaces": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}, "fields": {"$ref": "#/$defs/fieldMap"}}}]},
    "fieldMap": {"type": "object", "minProperties": 1, "maxProperties": 256, "additionalProperties": {"type": "string", "minLength": 1}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["baseline", "candidate"], "properties": {"baseline": {"$ref": "#/$defs/input"}, "candidate": {"$ref": "#/$defs/input"}}},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "bytes", "columns", "partitions", "schema"],
      "properties": {
        "format": {"enum": ["csv", "tsv", "jsonl", "parquet", "sqlite", "xlsx", "json", "xml"]},
        "bytes": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 1}, "partitions": {"type": "integer", "minimum": 1},
        "table": {"type": "string", "minLength": 1}, "delimiter": {"type": "string", "minLength": 1, "maxLength": 1},
        "null_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "worksheet": {"type": "string", "minLength": 1}, "range": {"type": "string", "minLength": 1}, "pointer": {"type": "string"},
        "record_path": {"type": "string", "minLength": 1}, "namespaces": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "compression": {"enum": ["gzip", "zip"]}, "decoded_bytes": {"type": "integer", "minimum": 0},
        "records": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "rows", "invalid_rows", "invalid_fields", "null_key_rows", "duplicate_keys"],
          "properties": {
            "status": {"enum": ["valid", "invalid"]},
            "rows": {"type": "integer", "minimum": 0},
            "invalid_rows": {"type": "integer", "minimum": 0},
            "invalid_fields": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "null_key_rows": {"type": "integer", "minimum": 0},
            "duplicate_keys": {"type": "integer", "minimum": 0}
          }
        },
        "schema": {
          "type": "object", "additionalProperties": false,
          "required": ["missing", "unexpected", "mapped", "excluded_present"],
          "properties": {
            "missing": {"type": "array", "items": {"type": "string"}},
            "unexpected": {"type": "array", "items": {"type": "string"}},
            "mapped": {"type": "object", "additionalProperties": {"type": "string"}},
            "excluded_present": {"type": "array", "items": {"type": "string"}}
          }
        }
      },
      "allOf": [{"if": {"properties": {"format": {"const": "xlsx"}}, "required": ["format"]}, "then": {"required": ["worksheet", "range", "compression", "decoded_bytes"], "properties": {"compression": {"const": "zip"}}}}, {"if": {"properties": {"format": {"const": "json"}}, "required": ["format"]}, "then": {"required": ["pointer"]}}, {"if": {"properties": {"format": {"const": "xml"}}, "required": ["format"]}, "then": {"required": ["record_path", "namespaces"]}}]
    }
  }
}
