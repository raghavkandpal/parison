{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raghavkandpal/parison/schemas/preflight-v1.schema.json",
  "title": "Parison preflight result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "comparison_mode", "keys", "canonical_columns", "policy_sha256", "inputs"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["valid", "invalid"]},
    "comparison_mode": {"const": "keyed"},
    "keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "canonical_columns": {"type": "integer", "minimum": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "#/$defs/input"},
        "candidate": {"$ref": "#/$defs/input"}
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "bytes", "columns", "partitions", "schema"],
      "properties": {
        "format": {"enum": ["csv", "tsv", "jsonl", "parquet", "sqlite"]},
        "bytes": {"type": "integer", "minimum": 0},
        "columns": {"type": "integer", "minimum": 1},
        "partitions": {"type": "integer", "minimum": 1},
        "table": {"type": "string", "minLength": 1},
        "delimiter": {"type": "string", "minLength": 1, "maxLength": 1},
        "null_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "records": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "rows", "invalid_rows", "invalid_fields", "null_key_rows", "duplicate_keys"],
          "properties": {
            "status": {"enum": ["valid", "invalid"]},
            "rows": {"type": "integer", "minimum": 0},
            "invalid_rows": {"type": "integer", "minimum": 0},
            "invalid_fields": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 1}
            },
            "null_key_rows": {"type": "integer", "minimum": 0},
            "duplicate_keys": {"type": "integer", "minimum": 0}
          }
        },
        "compression": {"const": "gzip"},
        "decoded_bytes": {"type": "integer", "minimum": 0},
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["missing", "unexpected", "mapped", "excluded_present"],
          "properties": {
            "missing": {"type": "array", "items": {"type": "string"}},
            "unexpected": {"type": "array", "items": {"type": "string"}},
            "mapped": {"type": "object", "additionalProperties": {"type": "string"}},
            "excluded_present": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
