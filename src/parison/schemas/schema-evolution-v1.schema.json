{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/schema-evolution-v1.schema.json",
  "title": "Parison schema evolution declaration v1",
  "type": "object",
  "required": ["evolution_version", "direction", "changes"],
  "properties": {
    "evolution_version": {"const": 1},
    "direction": {"const": "baseline-to-candidate"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/change"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": ["id", "name", "presence", "nullability"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "presence": {"enum": ["required", "optional"]},
        "nullability": {"enum": ["non-null", "nullable"]},
        "default": {"type": ["null", "boolean", "integer", "number", "string"]}
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["change", "baseline", "candidate"],
      "properties": {
        "change": {"enum": ["unchanged", "renamed", "added", "removed", "split", "merged"]},
        "baseline": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "candidate": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      },
      "additionalProperties": false
    }
  }
}
