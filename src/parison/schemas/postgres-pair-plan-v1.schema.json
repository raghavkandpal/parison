{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/postgres-pair-plan-v1.schema.json",
  "title": "postgres-pair-plan-v1",
  "type": "object",
  "required": [
    "pair_plan_version",
    "source_id",
    "tables",
    "limits"
  ],
  "properties": {
    "pair_plan_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "type": "object",
      "required": [
        "orders",
        "order_lines"
      ],
      "properties": {
        "orders": {
          "type": "object",
          "required": [
            "schema",
            "table",
            "columns",
            "primary_key"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            },
            "primary_key": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            }
          },
          "additionalProperties": false
        },
        "order_lines": {
          "type": "object",
          "required": [
            "schema",
            "table",
            "columns",
            "primary_key"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            },
            "primary_key": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_rows",
        "max_output_bytes",
        "statement_timeout_ms",
        "wall_timeout_ms"
      ],
      "properties": {
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "statement_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "wall_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
