{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_result_version",
    "complete",
    "outcome",
    "manifest_sha256",
    "policy",
    "diagnostic_sha256",
    "semantic_result",
    "files",
    "bindings",
    "closed_scope_status",
    "reason_codes"
  ],
  "properties": {
    "manifest_result_version": {
      "const": 2
    },
    "complete": {
      "const": true
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "suite",
            "reconciliation"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "diagnostic_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outcome",
            "manifest_sha256",
            "input_bindings_sha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "suite",
                "reconciliation"
              ]
            },
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE"
              ]
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "input_bindings_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "expected_bytes",
          "expected_sha256",
          "observed_bytes",
          "observed_sha256",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expected_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "observed_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "match",
              "missing",
              "size-mismatch",
              "digest-mismatch"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "source_sha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "match",
              "member-mismatch"
            ]
          }
        }
      }
    },
    "closed_scope_status": {
      "enum": [
        "match",
        "undeclared-members"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "missing-resource",
          "size-mismatch",
          "digest-mismatch",
          "logical-member-mismatch",
          "undeclared-members"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/manifest-result-v2.schema.json",
  "oneOf": [
    {
      "properties": {
        "semantic_result": {
          "type": "null"
        },
        "diagnostic_sha256": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "semantic_result": {
          "type": "object"
        },
        "diagnostic_sha256": {
          "type": "string"
        }
      }
    }
  ]
}
