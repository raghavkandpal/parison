{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/partition-session-v1.schema.json",
  "title": "partition-session-v1",
  "description": "Structural validation only; canonical bytes, exact JSON tokens, cross-file bindings and execution assurance require the semantic reader/replay gate.",
  "type": "object",
  "required": [
    "partition_session_version",
    "state",
    "identity",
    "max_session_bytes",
    "routing",
    "results",
    "published_manifest_sha256"
  ],
  "properties": {
    "partition_session_version": {
      "type": "integer",
      "const": 1
    },
    "state": {
      "enum": [
        "initializing",
        "routed",
        "comparing",
        "ready",
        "published",
        "abandoning"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "plan_sha256",
        "policy_sha256",
        "derived_recipe_sha256",
        "inputs",
        "columns",
        "normalization_runtime",
        "engine"
      ],
      "properties": {
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "derived_recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normalization_runtime": {
          "type": "object",
          "required": [
            "implementation",
            "python_version",
            "unicode_version"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "const": "CPython"
            },
            "python_version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 9,
              "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,3}$",
              "not": {
                "pattern": "[^0-9.]"
              }
            },
            "unicode_version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 8,
              "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,2}$",
              "not": {
                "pattern": "[^0-9.]"
              }
            }
          },
          "additionalProperties": false
        },
        "engine": {
          "type": "object",
          "required": [
            "contract",
            "parison_version",
            "package_sha256"
          ],
          "properties": {
            "contract": {
              "const": "partition-session-engine-v1"
            },
            "parison_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\u0000-\\u007f]+$"
            },
            "package_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "max_session_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100000000
    },
    "routing": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/routing"
        }
      ]
    },
    "results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/descriptor"
          }
        ]
      }
    },
    "published_manifest_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "initializing"
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "type": "null"
          },
          "results": {
            "items": {
              "type": "null"
            }
          },
          "published_manifest_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "routed"
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "$ref": "#/$defs/routing"
          },
          "results": {
            "items": {
              "type": "null"
            }
          },
          "published_manifest_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "comparing"
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "$ref": "#/$defs/routing"
          },
          "published_manifest_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "$ref": "#/$defs/routing"
          },
          "results": {
            "items": {
              "$ref": "#/$defs/descriptor"
            }
          },
          "published_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "$ref": "#/$defs/routing"
          },
          "results": {
            "items": {
              "$ref": "#/$defs/descriptor"
            }
          },
          "published_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  ],
  "$defs": {
    "inputs": {
      "type": "object",
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "side": {
      "type": "object",
      "required": [
        "rows",
        "bytes",
        "sha256"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "descriptor": {
      "type": "object",
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "receipt",
        "files"
      ],
      "properties": {
        "receipt": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "inputs",
                "route_rows",
                "staged_bytes",
                "partitions"
              ],
              "properties": {
                "inputs": {
                  "$ref": "#/$defs/inputs"
                },
                "route_rows": {
                  "type": "object",
                  "required": [
                    "baseline",
                    "candidate"
                  ],
                  "properties": {
                    "baseline": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000000
                    },
                    "candidate": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000000
                    }
                  },
                  "additionalProperties": false
                },
                "staged_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000000000
                },
                "partitions": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "required": [
                      "upper",
                      "baseline",
                      "candidate"
                    ],
                    "properties": {
                      "upper": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "baseline": {
                        "$ref": "#/$defs/side"
                      },
                      "candidate": {
                        "$ref": "#/$defs/side"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "inputs",
                "route_rows",
                "staged_bytes",
                "partitions",
                "derived_recipe_bytes"
              ],
              "properties": {
                "inputs": {
                  "$ref": "#/$defs/inputs"
                },
                "route_rows": {
                  "type": "object",
                  "required": [
                    "baseline",
                    "candidate"
                  ],
                  "properties": {
                    "baseline": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000000
                    },
                    "candidate": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000000
                    }
                  },
                  "additionalProperties": false
                },
                "staged_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000000000
                },
                "partitions": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "required": [
                      "bucket",
                      "baseline",
                      "candidate"
                    ],
                    "properties": {
                      "bucket": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 127
                      },
                      "baseline": {
                        "$ref": "#/$defs/side"
                      },
                      "candidate": {
                        "$ref": "#/$defs/side"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "derived_recipe_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 262144
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "files": {
          "type": "object",
          "minProperties": 7,
          "maxProperties": 259,
          "required": [
            "snapshot-baseline.csv",
            "snapshot-candidate.csv",
            "derived-recipe.json"
          ],
          "properties": {
            "snapshot-baseline.csv": {
              "type": "object",
              "required": [
                "sha256",
                "bytes"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            },
            "snapshot-candidate.csv": {
              "type": "object",
              "required": [
                "sha256",
                "bytes"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            },
            "derived-recipe.json": {
              "type": "object",
              "required": [
                "sha256",
                "bytes"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 262144
                }
              },
              "additionalProperties": false
            }
          },
          "patternProperties": {
            "^(?:baseline|candidate)-(?:0|[1-9][0-9]?|1[01][0-9]|12[0-7])\\.csv$": {
              "type": "object",
              "required": [
                "sha256",
                "bytes"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "propertyNames": {
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
