{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raghavkandpal/parison/schemas/suite-v2.schema.json",
  "title": "Parison comparison suite v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "cases"],
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1},
        "max_decoded_bytes": {"type": "integer", "minimum": 1},
        "max_rows": {"type": "integer", "minimum": 1},
        "max_groups": {"type": "integer", "minimum": 1},
        "max_distinct_rows": {"type": "integer", "minimum": 1}
      }
    },
    "identifier": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  },
  "properties": {
    "suite_version": {"const": 2},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"limits": {"$ref": "#/$defs/limits"}}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recipe", "baseline", "candidate"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "recipe": {"type": "string", "minLength": 1},
          "baseline": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1},
          "expected_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "limits": {"$ref": "#/$defs/limits"}
        }
      }
    }
  }
}
