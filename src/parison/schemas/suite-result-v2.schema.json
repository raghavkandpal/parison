{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raghavkandpal/parison/schemas/suite-result-v2.schema.json",
  "title": "Parison suite result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_version", "kind", "outcome", "complete", "scope_complete", "execution_complete", "runtime", "total_cases", "selected_cases", "completed_cases", "outcome_counts", "selection", "cases", "suite_policy_sha256", "effective_suite_sha256"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "outcome": {"enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "INTERRUPTED"]}
  },
  "properties": {
    "schema_version": {"const": 2},
    "suite_version": {"const": 2},
    "kind": {"enum": ["suite", "suite-shard"]},
    "outcome": {"$ref": "#/$defs/outcome"},
    "complete": {"type": "boolean"},
    "scope_complete": {"type": "boolean"},
    "execution_complete": {"type": "boolean"},
    "runtime": {"type": "object"},
    "total_cases": {"type": "integer", "minimum": 1, "maximum": 100},
    "selected_cases": {"type": "integer", "minimum": 1, "maximum": 100},
    "completed_cases": {"type": "integer", "minimum": 1, "maximum": 100},
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "INTERRUPTED"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0}, "FAIL": {"type": "integer", "minimum": 0},
        "ERROR": {"type": "integer", "minimum": 0}, "INCONCLUSIVE": {"type": "integer", "minimum": 0},
        "INTERRUPTED": {"type": "integer", "minimum": 0}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids", "tags", "shard_index", "shard_count"],
      "properties": {
        "case_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "shard_index": {"type": ["integer", "null"], "minimum": 0},
        "shard_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 100}
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "outcome", "complete", "schema_version", "contract", "policy_sha256", "manifest_sha256", "bundle"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"}, "outcome": {"$ref": "#/$defs/outcome"}, "complete": {"type": "boolean"},
          "schema_version": {"type": "integer", "minimum": 1, "maximum": 3},
          "contract": {"enum": ["keyed-v1", "aggregate-v1", "multiset-v1"]},
          "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bundle": {"type": "string", "pattern": "^cases/[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "suite_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
