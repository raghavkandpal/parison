{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/partition-checkpoint-v1.schema.json",
  "title": "partition-checkpoint-v1",
  "description": "Structural validation only; canonical bytes, exact JSON tokens, cross-file bindings and execution assurance require the semantic reader/replay gate.",
  "type": "object",
  "required": [
    "partition_checkpoint_version",
    "index",
    "policy_sha256",
    "engine_sha256",
    "inputs",
    "result"
  ],
  "properties": {
    "partition_checkpoint_version": {
      "type": "integer",
      "const": 1
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "engine_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "inputs": {
      "type": "object",
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/side"
        },
        "candidate": {
          "$ref": "#/$defs/side"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "counts",
        "field_counts",
        "discrepancy_count",
        "outcome",
        "complete"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "required": [
            "baseline",
            "candidate",
            "common_keys",
            "baseline_only",
            "candidate_only",
            "matched_exact",
            "matched_within_tolerance",
            "matched_with_required_difference"
          ],
          "properties": {
            "baseline": {
              "type": "integer",
              "minimum": 0
            },
            "candidate": {
              "type": "integer",
              "minimum": 0
            },
            "common_keys": {
              "type": "integer",
              "minimum": 0
            },
            "baseline_only": {
              "type": "integer",
              "minimum": 0
            },
            "candidate_only": {
              "type": "integer",
              "minimum": 0
            },
            "matched_exact": {
              "type": "integer",
              "minimum": 0
            },
            "matched_within_tolerance": {
              "type": "integer",
              "minimum": 0
            },
            "matched_with_required_difference": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "field_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "exact",
              "within_tolerance",
              "different"
            ],
            "properties": {
              "exact": {
                "type": "integer",
                "minimum": 0
              },
              "within_tolerance": {
                "type": "integer",
                "minimum": 0
              },
              "different": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "discrepancy_count": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "INCONCLUSIVE"
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "side": {
      "type": "object",
      "required": [
        "rows",
        "bytes",
        "sha256"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    }
  }
}
