{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "complete",
    "outcome",
    "manifest_sha256",
    "policy",
    "diagnostic_sha256",
    "semantic_result",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "dataset-evidence"
    },
    "complete": {
      "const": true
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "suite",
            "reconciliation"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "diagnostic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome",
        "manifest_sha256",
        "input_bindings_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "suite",
            "reconciliation"
          ]
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_bindings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset-manifest.json",
        "manifest-result.json",
        "effective-policy.json",
        "reproducibility-diagnostic.json"
      ],
      "properties": {
        "dataset-manifest.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest-result.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective-policy.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reproducibility-diagnostic.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parison.dev/schemas/dataset-evidence-v2.schema.json"
}
